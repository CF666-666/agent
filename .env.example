# ============================================================
# Ragent 环境变量示例（复制为 .env 后按需修改）
# docker compose 自动读取同目录 .env 文件
# ============================================================

# 阿里云百炼 API Key（Chat / Rerank 模型，问答功能必需）
BAILIAN_API_KEY=

# SiliconFlow API Key（多模态 Embedding，缺省时回退 Ollama 本地模型）
SILICONFLOW_API_KEY=
