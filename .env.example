# ============================================================
# Ragent 环境变量示例（复制为 .env 后按需修改）
# docker compose 自动读取同目录 .env 文件
# ============================================================

# SiliconFlow API Key（Chat / Embedding / Rerank / Vision，问答功能必需）
SILICONFLOW_API_KEY=

# Optional DashScope adapter key; candidates are disabled by default in application.yaml.
BAILIAN_API_KEY=
